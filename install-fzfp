#!/bin/sh
# Download an official binary and verify its release checksum. No sudo needed.
set -eu
bin_dir=${HOME:?HOME is required}/.local/bin
version=0.1.0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --bin-dir|--version)
      [ "$#" -ge 2 ] || { echo "Missing value for $1" >&2; exit 2; }
      case "$1" in --bin-dir) bin_dir=$2 ;; --version) version=$2 ;; esac
      shift 2 ;;
    -h|--help)
      echo 'Usage: sh install-fzfp [--bin-dir DIR] [--version X.Y.Z]'
      exit 0 ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done
case "$(uname -s)" in Linux) os=linux ;; Darwin) os=darwin ;; *) echo 'Supported systems: Linux, macOS' >&2; exit 1 ;; esac
case "$(uname -m)" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) echo 'Supported architectures: amd64, arm64' >&2; exit 1 ;; esac
base=https://github.com/zhiyozhao/fzf-pinyin/releases
if [ "$version" = latest ]; then
  base=$base/latest/download
else
  printf '%s\n' "$version" | LC_ALL=C grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || { echo 'Invalid version' >&2; exit 2; }
  base=$base/download/fzfp-v$version
fi
work=$(mktemp -d)
staged=
trap 'rm -rf "$work"; if [ -n "$staged" ]; then rm -f "$staged"; fi' EXIT HUP INT TERM
fetch() { curl --fail --location --silent --show-error --proto '=https' --proto-redir '=https' --retry 3 "$1" -o "$2"; }
fetch "$base/checksums.txt" "$work/checksums.txt"
entry=$(LC_ALL=C awk -v os="$os" -v arch="$arch" -v ver="$version" '
  NF == 2 && length($1) == 64 && $1 !~ /[^0-9a-fA-F]/ &&
  $2 ~ ("^fzfp-[0-9]+\\.[0-9]+\\.[0-9]+-" os "_" arch "\\.tar\\.gz$") &&
  (ver == "latest" || $2 == "fzfp-" ver "-" os "_" arch ".tar.gz") { print $1 " " $2; count++ }
  END { if (count != 1) exit 1 }
' "$work/checksums.txt") || { echo 'Missing or ambiguous release checksum' >&2; exit 1; }
expected=${entry%% *}
archive=${entry#* }
# Pin the asset to the version found in checksums, even if latest changes now.
resolved=${archive#fzfp-}
resolved=${resolved%-$os\_$arch.tar.gz}
fetch "https://github.com/zhiyozhao/fzf-pinyin/releases/download/fzfp-v$resolved/$archive" "$work/archive.tar.gz"
if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$work/archive.tar.gz")
else
  actual=$(shasum -a 256 "$work/archive.tar.gz")
fi
test "$(printf '%s' "${actual%% *}" | tr A-F a-f)" = "$(printf '%s' "$expected" | tr A-F a-f)" || { echo 'SHA256 mismatch; nothing installed' >&2; exit 1; }
tar -xzf "$work/archive.tar.gz" -C "$work" fzfp
test -f "$work/fzfp" && test ! -L "$work/fzfp"
mkdir -p "$bin_dir"
staged=$(mktemp "$bin_dir/.fzfp.XXXXXXXX")
install -m 755 "$work/fzfp" "$staged"
mv -f "$staged" "$bin_dir/fzfp"
staged=
echo "Installed $bin_dir/fzfp ($resolved). Add $bin_dir to PATH if needed."
